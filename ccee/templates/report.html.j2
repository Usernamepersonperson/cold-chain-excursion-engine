<!doctype html>
<html lang="en"><head><meta charset="utf-8">
<title>Shipment report {{ r.shipment_id }}</title>
<style>
 body{font-family:"Segoe UI",Arial,sans-serif;max-width:900px;margin:24px auto;color:#0f172a;font-size:13px}
 h1{font-size:20px;margin-bottom:2px} h2{font-size:15px;border-bottom:1px solid #cbd5e1;padding-bottom:3px;margin-top:22px}
 table{border-collapse:collapse;width:100%} th,td{border:1px solid #cbd5e1;padding:4px 7px;text-align:left;vertical-align:top}
 th{background:#f1f5f9} .crit{color:#b91c1c;font-weight:600} .warn{color:#b45309;font-weight:600} .ok{color:#047857;font-weight:600}
 .note{background:#fff7ed;border:1px solid #fed7aa;padding:8px;margin:10px 0} code{font-size:11px;word-break:break-all}
 .sig td{height:34px}
</style></head><body>
<h1>Shipment temperature report: {{ r.shipment_id }}</h1>
<div>Generated by ccee {{ r.version }} on {{ r.generated }}. {{ r.data_label }}</div>
<div class="note">This is an automated analysis aid. It is not validated for regulated use and makes no claim of regulatory compliance.
Disposition of the shipment is a decision for the responsible quality person.</div>

<h2>1. Shipment</h2>
<table>
{% for k, v in r.header %}<tr><th style="width:28%">{{ k }}</th><td>{{ v }}</td></tr>{% endfor %}
</table>

<h2>2. Assessment summary</h2>
<table>
<tr><th>Allowed range</th><td>{{ r.profile.lo }} to {{ r.profile.hi }} C ({{ r.profile.name }})</td></tr>
<tr><th>Readings / observed time</th><td>{{ r.stats.n }} readings over {{ "%.1f"|format(r.stats.duration_h) }} h; observed {{ "%.1f"|format(r.stats.observed_h) }} h; data gaps {{ "%.1f"|format(r.stats.gap_h) }} h</td></tr>
<tr><th>Min / mean / max</th><td>{{ "%.1f"|format(r.stats.min_c) }} / {{ "%.1f"|format(r.stats.mean_c) }} / {{ "%.1f"|format(r.stats.max_c) }} C</td></tr>
<tr><th>Time in range (observed)</th><td>{{ "%.1f"|format(r.stats.in_range_pct) }} %</td></tr>
<tr><th>Mean kinetic temperature</th><td>{{ "%.2f"|format(r.mkt_c) }} C (dH = {{ r.profile.delta_h_kj_mol }} kJ/mol){% if r.profile.mkt_limit_c is not none %}; reference limit {{ r.profile.mkt_limit_c }} C{% endif %}</td></tr>
<tr><th>Excursions</th><td>{% if r.events %}<span class="crit">{{ r.events|length }} detected</span>{% else %}<span class="ok">none detected</span>{% endif %}</td></tr>
<tr><th>Stability allowance used</th><td>{{ r.budget_text }}</td></tr>
<tr><th>Automated flag</th><td>{% if r.needs_review %}<span class="crit">REVIEW REQUIRED</span>{% else %}<span class="ok">no excursion or critical data-integrity flag</span>{% endif %}</td></tr>
</table>
<p><img alt="temperature chart" style="width:100%" src="data:image/png;base64,{{ r.chart_b64 }}"></p>

<h2>3. Excursions</h2>
{% if r.events %}
<table><tr><th>#</th><th>Direction</th><th>Start (UTC)</th><th>End (UTC)</th><th>Minutes</th><th>Peak (C)</th><th>Degree-min</th><th>Location (nearest GPS fix)</th><th>Notes</th></tr>
{% for e in r.events %}<tr><td>{{ loop.index }}</td><td>{{ e.direction }}</td><td>{{ e.start }}</td><td>{{ e.end }}</td><td>{{ e.minutes }}</td><td>{{ e.peak }}</td><td>{{ e.dm }}</td><td>{{ e.where }}</td><td>{{ e.notes }}</td></tr>{% endfor %}
</table>
<p>Convention: an excursion runs from the first out-of-range reading to the first reading back in range; two consecutive out-of-range readings are needed to open one.</p>
{% else %}<p>None.</p>{% endif %}

<h2>4. Cumulative time outside range and stability allowance</h2>
<table><tr><th>Band (C)</th><th>Minutes used</th><th>Illustrative allowance (min)</th><th>Fraction</th></tr>
{% for b in r.bands %}<tr><td>{{ b.label }}</td><td>{{ b.used }}</td><td>{{ b.allowed }}</td><td>{{ b.frac }}</td></tr>{% endfor %}
</table>
<p>Allowances are configurable placeholders, not product stability data. Fractions add up as one shared allowance.</p>

<h2>5. Alarms and early warnings</h2>
{% if r.alarms %}<table><tr><th>Time (UTC)</th><th>Rule</th><th>Severity</th><th>Message</th></tr>
{% for a in r.alarms %}<tr><td>{{ a.ts }}</td><td>{{ a.rule }}</td><td class="{{ 'crit' if a.severity == 'critical' else 'warn' }}">{{ a.severity }}</td><td>{{ a.message }}</td></tr>{% endfor %}</table>
{% else %}<p>None.</p>{% endif %}

<h2>6. Data-integrity checks (ALCOA+ oriented)</h2>
{% if r.flags %}<table><tr><th>Check</th><th>Severity</th><th>ALCOA+ attribute</th><th>Finding</th></tr>
{% for f in r.flags %}<tr><td>{{ f.code }}</td><td class="{{ 'crit' if f.severity == 'critical' else ('warn' if f.severity == 'warning' else '') }}">{{ f.severity }}</td><td>{{ f.alcoa }}</td><td>{{ f.message }}</td></tr>{% endfor %}</table>
{% else %}<p class="ok">No findings.</p>{% endif %}

<h2>7. Audit trail (hash-chained)</h2>
<p>Chain verification: <b class="{{ 'ok' if r.audit_ok else 'crit' }}">{{ r.audit_msg }}</b>. Head hash: <code>{{ r.audit_head }}</code></p>
<table><tr><th>#</th><th>Time (UTC)</th><th>Actor</th><th>Action</th><th>Hash (first 12)</th></tr>
{% for e in r.audit_rows %}<tr><td>{{ e.seq }}</td><td>{{ e.ts }}</td><td>{{ e.actor }}</td><td>{{ e.action }}</td><td><code>{{ e.hash[:12] }}</code></td></tr>{% endfor %}</table>
{% if r.audit_more %}<p>{{ r.audit_more }} further entries are in the exported audit file.</p>{% endif %}

<h2>8. Review</h2>
<table class="sig"><tr><th>Reviewer (name, role)</th><th>Decision</th><th>Date</th><th>Signature meaning</th></tr><tr><td>{{ r.reviewer or "" }}</td><td></td><td></td><td></td></tr></table>
</body></html>
